<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Pedal BlockFX.NET</AssemblyName>
    <RootNamespace>PedalBlockFX</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>MSB3277</NoWarn>
    <ReBuzzPath>C:\Program Files\ReBuzz</ReBuzzPath>
  </PropertyGroup>

  <!-- Headless test harness (Mono + C++ reference) lives in tests/ and is not part of the machine. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BuzzGUI.Interfaces">
      <HintPath>$(ReBuzzPath)\BuzzGUI.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BuzzGUI.Common">
      <HintPath>$(ReBuzzPath)\BuzzGUI.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Build notes §3.5.1: deploy the preset bundle only under its exact auto-load name,
       and warn loudly (naming what IS there) if it's missing. -->
  <Target Name="DeployToReBuzz" AfterTargets="Build">
    <PropertyGroup>
      <_PresetPath>$(MSBuildProjectDirectory)\Pedal BlockFX.prs.xml</_PresetPath>
    </PropertyGroup>
    <ItemGroup>
      <_AnyPreset Include="$(MSBuildProjectDirectory)\*.prs.xml" />
    </ItemGroup>

    <Message Text="Deploying $(TargetFileName) -> $(ReBuzzPath)\Gear\Effects\" Importance="high" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(ReBuzzPath)\Gear\Effects\"
          ContinueOnError="true" />

    <Message Condition="Exists('$(_PresetPath)')"
             Text="Deploying preset bundle -> $(ReBuzzPath)\Gear\Effects\" Importance="high" />
    <Copy Condition="Exists('$(_PresetPath)')"
          SourceFiles="$(_PresetPath)"
          DestinationFolder="$(ReBuzzPath)\Gear\Effects\"
          ContinueOnError="true" />
    <Warning Condition="!Exists('$(_PresetPath)')"
             Text="Preset bundle NOT deployed: '$(_PresetPath)' not found. Found instead: @(_AnyPreset). Run gen_presets.py." />
  </Target>

</Project>
